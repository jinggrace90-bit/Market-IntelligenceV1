# ─────────────────────────────────────────────────────────────
# Market Intelligence Dashboard — environment configuration
# Copy this file to `.env` (`cp .env.example .env`) before running.
# The app runs with ZERO keys set — those below only unlock extras.
# ─────────────────────────────────────────────────────────────

# --- Database (used by docker-compose + server) ---
POSTGRES_USER=mid
POSTGRES_PASSWORD=mid_password
POSTGRES_DB=market_intelligence

# --- Auth ---
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- CORS / URLs ---
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# OPTIONAL API KEYS — the app works without any of these.
# Leave blank to use the free, no-key data sources.
# ─────────────────────────────────────────────────────────────

# Finnhub (https://finnhub.io) — richer real-time quotes + company news
FINNHUB_API_KEY=

# NewsAPI (https://newsapi.org) — supplements the free RSS feeds
NEWSAPI_KEY=

# Alpha Vantage (https://www.alphavantage.co) — economic indicators
ALPHAVANTAGE_API_KEY=

# Anthropic Claude (https://console.anthropic.com) — AI news & macro analysis
# Without this, AI endpoints return a "configure a key" notice instead of analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
