# ─────────────────────────────────────────────────────────────
# Market Intelligence Dashboard — environment configuration
# Copy this file to `.env` (`cp .env.example .env`) before running.
# The app runs with ZERO keys set — those below only unlock extras.
# ─────────────────────────────────────────────────────────────

# --- Database (used by docker-compose + server) ---
POSTGRES_USER=mid
POSTGRES_PASSWORD=mid_password
POSTGRES_DB=market_intelligence

# When running the Python server OUTSIDE docker (e.g. `uvicorn` locally), point
# it at your local Postgres/Redis. Inside docker-compose these are set for you.
# The `?schema=public` suffix (Prisma-style) is accepted and ignored.
DATABASE_URL=postgresql://mid:mid_password@localhost:5432/market_intelligence
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=please_change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- CORS / URLs ---
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# OPTIONAL API KEYS — the app works without any of these.
# Leave blank to use the free, no-key data sources.
# ─────────────────────────────────────────────────────────────

# Finnhub (https://finnhub.io) — richer real-time quotes + company news
FINNHUB_API_KEY=

# NewsAPI (https://newsapi.org) — supplements the free RSS feeds
NEWSAPI_KEY=

# Alpha Vantage (https://www.alphavantage.co) — economic indicators
ALPHAVANTAGE_API_KEY=

# ─────────────────────────────────────────────────────────────
# AI provider — powers "AI News Analysis" + "AI Macro Analysis".
# ─────────────────────────────────────────────────────────────

# AI_PROVIDER=anthropic (default) uses Claude via ANTHROPIC_API_KEY below.
# AI_PROVIDER=local uses ANY OpenAI-compatible server. Two free options:
#   (a) Local, on your own machine — install Ollama (https://ollama.com), then
#       `ollama pull qwen2.5:3b`. No key, no cost, but only runs while your
#       computer is on. (No need to hand-convert MLX <-> GGUF — pull whatever
#       format your runtime already uses.)
#   (b) Free CLOUD API (works 24/7, no machine of yours needed) — e.g. Groq
#       (https://console.groq.com) has a generous free tier. Set:
#         AI_PROVIDER=local
#         LOCAL_AI_BASE_URL=https://api.groq.com/openai/v1
#         LOCAL_AI_API_KEY=<your Groq key>
#         LOCAL_AI_MODEL=openai/gpt-oss-120b   # Groq retires models on a few
#                                              # months' notice — check
#                                              # console.groq.com/docs/models
#                                              # and prefer a "Production"
#                                              # one over a "Preview" one.
AI_PROVIDER=anthropic

# Anthropic Claude (https://console.anthropic.com) — only used when
# AI_PROVIDER=anthropic. Without a key, AI endpoints return a
# "configure a key" notice instead of analysis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI-compatible server — only used when AI_PROVIDER=local.
# Defaults match a local Ollama. For a hosted API (Groq/Gemini) set the base
# URL + model to that provider's, and put its key in LOCAL_AI_API_KEY.
# If the API server runs inside docker-compose and Ollama runs on your HOST
# machine, use http://host.docker.internal:11434/v1 instead of localhost.
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=qwen2.5:3b
# Ignored by Ollama; required by hosted providers (Groq/Gemini/OpenRouter).
LOCAL_AI_API_KEY=
